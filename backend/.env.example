# OpenAI API Key (Required for live debates)
OPENAI_API_KEY=

# Optional: Custom OpenAI-compatible base URL (e.g. for Ollama, Groq, OpenRouter, vLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default Models
MODEL_NAME=gpt-4o-mini
TOPIC_REVIEW_MODEL=gpt-4o-mini
MODERATION_MODEL=omni-moderation-latest

# Temperature Settings (0.0 to 2.0)
MODEL_TEMPERATURE=0.7
JUDGE_TEMPERATURE=0.2

# Request Timeouts & Limits
MODEL_TIMEOUT_SECONDS=60

# Safety Guardrails
ENABLE_MODERATION=true
ENABLE_TOPIC_REVIEW=true

# CORS & Allowed Web Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8787,http://localhost:3000
